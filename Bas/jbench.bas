' jbench.bas - is single precision, or a cheaper call, worth having?
'
'   0..2  Julia inner loop, everything in LOCALS       - best case for single
'   4..5  the same arithmetic reading an MMBasic array - the common case
'   6..10 one multiply: direct, through the mmcsub.h shim, and through a
'         naked tail-jump stub, for float and for double
' Mode 3 is the bare loop, subtracted so what is left is the arithmetic alone.
Option explicit
Option default none

Const N = 200000

Dim integer r, m
Dim float t(10), a(10)
Dim float buf(255)
For m = 0 To 255 : buf(m) = 1.0 + m / 256.0 : Next m

For m = 0 To 10
  Timer = 0
  JBench r, m, N, buf()
  t(m) = Timer
Next m
For m = 0 To 10 : a(m) = t(m) - t(3) : Next m

Print
Print "N = "; N; "   CPU "; MM.Info(CpuSpeed); "   bare loop "; Str$(t(3), 0, 1); " ms"
Print
Print "                          total   arithmetic   ns/iter    vs double"
Print "locals only (Julia, 11 ops per iteration)"
Print "  double + int64 "; Str$(t(0), 9, 1); Str$(a(0), 12, 1); Str$(a(0) * 1e6 / N, 10, 0); Str$(a(0) / a(0), 10, 2); "x"
Print "  float  + int64 "; Str$(t(1), 9, 1); Str$(a(1), 12, 1); Str$(a(1) * 1e6 / N, 10, 0); Str$(a(0) / a(1), 10, 2); "x"
Print "  float  + int32 "; Str$(t(2), 9, 1); Str$(a(2), 12, 1); Str$(a(2) * 1e6 / N, 10, 0); Str$(a(0) / a(2), 10, 2); "x"
Print "reading an MMBasic float array"
Print "  double         "; Str$(t(4), 9, 1); Str$(a(4), 12, 1); Str$(a(4) * 1e6 / N, 10, 0); Str$(a(4) / a(4), 10, 2); "x"
Print "  float          "; Str$(t(5), 9, 1); Str$(a(5), 12, 1); Str$(a(5) * 1e6 / N, 10, 0); Str$(a(4) / a(5), 10, 2); "x"
Print "one multiply, by how it is reached"
Print "  float  direct  "; Str$(t(6), 9, 1); Str$(a(6), 12, 1); Str$(a(6) * 1e6 / N, 10, 0)
Print "  float  C shim  "; Str$(t(7), 9, 1); Str$(a(7), 12, 1); Str$(a(7) * 1e6 / N, 10, 0)
Print "  float  tail    "; Str$(t(8), 9, 1); Str$(a(8), 12, 1); Str$(a(8) * 1e6 / N, 10, 0); Str$(a(7) / a(8), 10, 2); "x"
Print "  double C shim  "; Str$(t(9), 9, 1); Str$(a(9), 12, 1); Str$(a(9) * 1e6 / N, 10, 0)
Print "  double tail    "; Str$(t(10), 9, 1); Str$(a(10), 12, 1); Str$(a(10) * 1e6 / N, 10, 0); Str$(a(9) / a(10), 10, 2); "x"

End

